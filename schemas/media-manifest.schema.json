{
  "$defs": {
    "AnalysisProxy": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "codec_name": {
          "const": "h264",
          "title": "Codec Name",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "format_name": {
          "enum": [
            "mov,mp4,m4a,3gp,3g2,mj2",
            "mov,mp4"
          ],
          "title": "Format Name",
          "type": "string"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "artifact",
        "format_name",
        "codec_name",
        "width",
        "height",
        "duration_ms"
      ],
      "title": "AnalysisProxy",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FrameIndex": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 0,
          "title": "Candidate Count",
          "type": "integer"
        },
        "duplicate_count": {
          "minimum": 0,
          "title": "Duplicate Count",
          "type": "integer"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/FrameRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "duration_ms",
        "candidate_count",
        "duplicate_count"
      ],
      "title": "FrameIndex",
      "type": "object"
    },
    "FrameReason": {
      "enum": [
        "periodic",
        "scene-change"
      ],
      "title": "FrameReason",
      "type": "string"
    },
    "FrameRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "candidate_timestamps_ms": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Candidate Timestamps Ms",
          "type": "array"
        },
        "frame_id": {
          "pattern": "^F[0-9]{6}$",
          "title": "Frame Id",
          "type": "string"
        },
        "perceptual_hash": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Perceptual Hash",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/FrameReason"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "timestamp_ms": {
          "minimum": 0,
          "title": "Timestamp Ms",
          "type": "integer"
        }
      },
      "required": [
        "frame_id",
        "timestamp_ms",
        "artifact",
        "perceptual_hash",
        "reasons",
        "candidate_timestamps_ms"
      ],
      "title": "FrameRecord",
      "type": "object"
    },
    "MediaProbe": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "format_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Format Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_time_ms": {
          "default": 0,
          "maximum": 86400000,
          "minimum": -86400000,
          "title": "Start Time Ms",
          "type": "integer"
        },
        "streams": {
          "items": {
            "$ref": "#/$defs/MediaStream"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Streams",
          "type": "array"
        }
      },
      "required": [
        "format_name",
        "duration_ms",
        "streams"
      ],
      "title": "MediaProbe",
      "type": "object"
    },
    "MediaRational": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "exclusiveMinimum": 0,
          "maximum": 2147483647,
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "MediaRational",
      "type": "object"
    },
    "MediaStream": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channels"
        },
        "codec_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Codec Name",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRational"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "is_default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Default"
        },
        "is_forced": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Forced"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "sample_rate_hz": {
          "anyOf": [
            {
              "maximum": 384000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate Hz"
        },
        "start_time_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": -86400000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time Ms"
        },
        "stream_type": {
          "$ref": "#/$defs/MediaStreamType"
        },
        "subtitle_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubtitleKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subtitle_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubtitleProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_base": {
          "$ref": "#/$defs/MediaRational"
        },
        "width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "index",
        "stream_type",
        "codec_name",
        "time_base"
      ],
      "title": "MediaStream",
      "type": "object"
    },
    "MediaStreamType": {
      "enum": [
        "video",
        "audio",
        "subtitle"
      ],
      "title": "MediaStreamType",
      "type": "string"
    },
    "NormalizationConfig": {
      "additionalProperties": false,
      "properties": {
        "analysis_crf": {
          "default": 23,
          "maximum": 51,
          "minimum": 0,
          "title": "Analysis Crf",
          "type": "integer"
        },
        "analysis_height": {
          "default": 360,
          "maximum": 4096,
          "minimum": 64,
          "title": "Analysis Height",
          "type": "integer"
        },
        "analysis_video_codec": {
          "const": "libx264",
          "default": "libx264",
          "title": "Analysis Video Codec",
          "type": "string"
        },
        "analysis_width": {
          "default": 640,
          "maximum": 4096,
          "minimum": 64,
          "title": "Analysis Width",
          "type": "integer"
        },
        "duration_tolerance_ms": {
          "default": 1000,
          "maximum": 10000,
          "minimum": 0,
          "title": "Duration Tolerance Ms",
          "type": "integer"
        },
        "frame_height": {
          "default": 180,
          "maximum": 1080,
          "minimum": 32,
          "title": "Frame Height",
          "type": "integer"
        },
        "frame_width": {
          "default": 320,
          "maximum": 1920,
          "minimum": 32,
          "title": "Frame Width",
          "type": "integer"
        },
        "maximum_decoded_audio_sample_slots_per_frame": {
          "default": 1048576,
          "description": "FFmpeg generic -max_samples decoder slots per input audio frame",
          "maximum": 1048576,
          "minimum": 1,
          "title": "Maximum Decoded Audio Sample Slots Per Frame",
          "type": "integer"
        },
        "maximum_decoded_video_pixel_slots_per_frame": {
          "default": 34070528,
          "description": "FFmpeg generic -max_pixels decoder slots per input frame",
          "maximum": 34070528,
          "minimum": 4096,
          "title": "Maximum Decoded Video Pixel Slots Per Frame",
          "type": "integer"
        },
        "maximum_duration_ms": {
          "default": 14400000,
          "exclusiveMinimum": 0,
          "maximum": 14400000,
          "title": "Maximum Duration Ms",
          "type": "integer"
        },
        "maximum_frame_candidates": {
          "default": 512,
          "maximum": 4096,
          "minimum": 1,
          "title": "Maximum Frame Candidates",
          "type": "integer"
        },
        "maximum_frame_output_bytes": {
          "default": 33554432,
          "maximum": 67108864,
          "minimum": 1048576,
          "title": "Maximum Frame Output Bytes",
          "type": "integer"
        },
        "maximum_output_bytes": {
          "default": 4294967296,
          "maximum": 8589934592,
          "minimum": 1048576,
          "title": "Maximum Output Bytes",
          "type": "integer"
        },
        "maximum_output_file_bytes": {
          "default": 1073741824,
          "maximum": 4294967296,
          "minimum": 1048576,
          "title": "Maximum Output File Bytes",
          "type": "integer"
        },
        "maximum_source_audio_channels": {
          "default": 8,
          "maximum": 64,
          "minimum": 1,
          "title": "Maximum Source Audio Channels",
          "type": "integer"
        },
        "maximum_source_audio_sample_rate_hz": {
          "default": 192000,
          "maximum": 384000,
          "minimum": 8000,
          "title": "Maximum Source Audio Sample Rate Hz",
          "type": "integer"
        },
        "maximum_source_height": {
          "default": 8192,
          "maximum": 32768,
          "minimum": 64,
          "title": "Maximum Source Height",
          "type": "integer"
        },
        "maximum_source_pixels": {
          "default": 33554432,
          "maximum": 33554432,
          "minimum": 4096,
          "title": "Maximum Source Pixels",
          "type": "integer"
        },
        "maximum_source_width": {
          "default": 8192,
          "maximum": 32768,
          "minimum": 64,
          "title": "Maximum Source Width",
          "type": "integer"
        },
        "maximum_streams": {
          "default": 128,
          "maximum": 4096,
          "minimum": 1,
          "title": "Maximum Streams",
          "type": "integer"
        },
        "maximum_subtitle_bytes": {
          "default": 16777216,
          "maximum": 67108864,
          "minimum": 1048576,
          "title": "Maximum Subtitle Bytes",
          "type": "integer"
        },
        "perceptual_hash_distance": {
          "default": 4,
          "maximum": 64,
          "minimum": 0,
          "title": "Perceptual Hash Distance",
          "type": "integer"
        },
        "periodic_frame_interval_seconds": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Periodic Frame Interval Seconds",
          "type": "number"
        },
        "scene_change_threshold": {
          "default": 0.3,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Scene Change Threshold",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speech_sample_rate_hz": {
          "default": 16000,
          "maximum": 96000,
          "minimum": 8000,
          "title": "Speech Sample Rate Hz",
          "type": "integer"
        },
        "stderr_limit_bytes": {
          "default": 4194304,
          "maximum": 67108864,
          "minimum": 4096,
          "title": "Stderr Limit Bytes",
          "type": "integer"
        },
        "stdout_limit_bytes": {
          "default": 4194304,
          "maximum": 67108864,
          "minimum": 4096,
          "title": "Stdout Limit Bytes",
          "type": "integer"
        },
        "timestamp_merge_tolerance_seconds": {
          "default": 0.01,
          "maximum": 1,
          "minimum": 0,
          "title": "Timestamp Merge Tolerance Seconds",
          "type": "number"
        },
        "tool_timeout_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Tool Timeout Seconds",
          "type": "number"
        }
      },
      "title": "NormalizationConfig",
      "type": "object"
    },
    "NormalizedSubtitle": {
      "additionalProperties": false,
      "properties": {
        "codec_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Codec Name",
          "type": "string"
        },
        "cue_count": {
          "default": 0,
          "minimum": 0,
          "title": "Cue Count",
          "type": "integer"
        },
        "cues_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_default": {
          "title": "Is Default",
          "type": "boolean"
        },
        "is_forced": {
          "title": "Is Forced",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/SubtitleKind"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "provenance": {
          "$ref": "#/$defs/SubtitleProvenance"
        },
        "raw_text_preserved": {
          "const": false,
          "default": false,
          "description": "Always false: WebVTT normalization does not preserve source cue markup",
          "title": "Raw Text Preserved",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/SubtitleStatus"
        },
        "stream_index": {
          "minimum": 0,
          "title": "Stream Index",
          "type": "integer"
        },
        "warning_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warning Code"
        },
        "webvtt_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "stream_index",
        "codec_name",
        "kind",
        "provenance",
        "is_default",
        "is_forced",
        "status"
      ],
      "title": "NormalizedSubtitle",
      "type": "object"
    },
    "SpeechAudio": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "channels": {
          "const": 1,
          "title": "Channels",
          "type": "integer"
        },
        "codec_name": {
          "const": "pcm_s16le",
          "title": "Codec Name",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "format_name": {
          "const": "wav",
          "title": "Format Name",
          "type": "string"
        },
        "sample_rate_hz": {
          "minimum": 1,
          "title": "Sample Rate Hz",
          "type": "integer"
        }
      },
      "required": [
        "artifact",
        "format_name",
        "codec_name",
        "sample_rate_hz",
        "channels",
        "duration_ms"
      ],
      "title": "SpeechAudio",
      "type": "object"
    },
    "SubtitleKind": {
      "enum": [
        "text",
        "bitmap",
        "unknown"
      ],
      "title": "SubtitleKind",
      "type": "string"
    },
    "SubtitleProvenance": {
      "enum": [
        "embedded",
        "official",
        "sidecar"
      ],
      "title": "SubtitleProvenance",
      "type": "string"
    },
    "SubtitleStatus": {
      "enum": [
        "normalized",
        "unsupported"
      ],
      "title": "SubtitleStatus",
      "type": "string"
    },
    "ToolIdentity": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Capabilities",
          "type": "array"
        },
        "executable_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Executable Sha256",
          "type": "string"
        },
        "name": {
          "enum": [
            "ffmpeg",
            "ffprobe"
          ],
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "executable_sha256"
      ],
      "title": "ToolIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/media-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_proxy": {
      "$ref": "#/$defs/AnalysisProxy"
    },
    "configuration": {
      "$ref": "#/$defs/NormalizationConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ffmpeg": {
      "$ref": "#/$defs/ToolIdentity"
    },
    "ffprobe": {
      "$ref": "#/$defs/ToolIdentity"
    },
    "frame_index": {
      "$ref": "#/$defs/FrameIndex"
    },
    "frame_index_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Implementation Version",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "normalization_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Normalization Fingerprint",
      "type": "string"
    },
    "probe": {
      "$ref": "#/$defs/MediaProbe"
    },
    "raw_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "speech_audio": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpeechAudio"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "subtitles": {
      "items": {
        "$ref": "#/$defs/NormalizedSubtitle"
      },
      "title": "Subtitles",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "normalization_fingerprint",
    "implementation_version",
    "configuration",
    "ffmpeg",
    "ffprobe",
    "raw_artifact",
    "probe",
    "analysis_proxy",
    "frame_index_artifact",
    "frame_index",
    "started_at",
    "created_at"
  ],
  "title": "MediaManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
