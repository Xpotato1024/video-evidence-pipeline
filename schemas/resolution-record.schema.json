{
  "$defs": {
    "DraftSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "description": "Exclusive Python Unicode code-point offset",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "description": "Inclusive Python Unicode code-point offset",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "DraftSpan",
      "type": "object"
    },
    "ResolutionDecision": {
      "enum": [
        "accept",
        "reject",
        "defer"
      ],
      "title": "ResolutionDecision",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/resolution-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "changed_spans": {
      "items": {
        "$ref": "#/$defs/DraftSpan"
      },
      "maxItems": 10000,
      "title": "Changed Spans",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ResolutionDecision"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Evidence Ids",
      "type": "array"
    },
    "finding_id": {
      "pattern": "^AF[0-9]{6}$",
      "title": "Finding Id",
      "type": "string"
    },
    "removed_spans": {
      "items": {
        "$ref": "#/$defs/DraftSpan"
      },
      "maxItems": 10000,
      "title": "Removed Spans",
      "type": "array"
    },
    "resolution": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Resolution",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "finding_id",
    "decision",
    "resolution"
  ],
  "title": "ResolutionRecord",
  "type": "object",
  "x-schema-version": "1.0"
}
