{
  "$id": "https://schemas.video-evidence-pipeline.local/v1/analyzer-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atomic_proposition_contract": {
      "anyOf": [
        {
          "const": "One record states one atomic proposition; every reference supports that same proposition; do not combine separate facts.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Semantic request rule for new input/refinement jobs; absent in v1 requests.",
      "title": "Atomic Proposition Contract"
    },
    "name": {
      "const": "video-evidence-analyzer",
      "default": "video-evidence-analyzer",
      "title": "Name",
      "type": "string"
    },
    "response_schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Response Schema Version",
      "type": "string"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "AnalyzerContract",
  "type": "object",
  "x-schema-version": "1.0"
}
