{
  "$id": "https://schemas.video-evidence-pipeline.local/v1/character-length-constraint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Raw assignment values; ``None`` means the author did not specify the bound.",
  "properties": {
    "max_chars": {
      "anyOf": [
        {
          "maximum": 4000000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Chars"
    },
    "maximum_adjustments": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Maximum Adjustments",
      "type": "integer"
    },
    "min_chars": {
      "anyOf": [
        {
          "maximum": 4000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Min Chars"
    }
  },
  "title": "CharacterLengthConstraint",
  "type": "object",
  "x-schema-version": "1.0"
}
