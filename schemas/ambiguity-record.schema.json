{
  "$defs": {
    "AmbiguityStatus": {
      "enum": [
        "unresolved",
        "resolved"
      ],
      "title": "AmbiguityStatus",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "needs_review",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "description": "Transcript-record semantic fingerprint or canonical frame artifact SHA-256",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "kind": {
          "$ref": "#/$defs/SourceRefKind"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "required": [
        "kind",
        "ref_id",
        "content_sha256"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceRefKind": {
      "enum": [
        "transcript_segment",
        "frame",
        "approved_artifact",
        "pdf_text",
        "pdf_page",
        "image",
        "notes"
      ],
      "title": "SourceRefKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/ambiguity-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguity_id": {
      "pattern": "^A[0-9]{6}$",
      "title": "Ambiguity Id",
      "type": "string"
    },
    "description": {
      "maxLength": 65536,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "end_ms": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End Ms"
    },
    "resolution": {
      "anyOf": [
        {
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution"
    },
    "review_status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "needs_review"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 128,
      "title": "Source Refs",
      "type": "array"
    },
    "start_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Ms"
    },
    "status": {
      "$ref": "#/$defs/AmbiguityStatus",
      "default": "unresolved"
    }
  },
  "required": [
    "ambiguity_id",
    "description"
  ],
  "title": "AmbiguityRecord",
  "type": "object",
  "x-schema-version": "1.0"
}
