{
  "$defs": {
    "AnalyzerExecutionMode": {
      "enum": [
        "external_exchange",
        "test_fixture"
      ],
      "title": "AnalyzerExecutionMode",
      "type": "string"
    },
    "AnalyzerIdentity": {
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "$ref": "#/$defs/AnalyzerExecutionMode"
        },
        "executor": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Executor",
          "type": "string"
        },
        "external_api_used": {
          "title": "External Api Used",
          "type": "boolean"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "executor",
        "execution_mode",
        "external_api_used"
      ],
      "title": "AnalyzerIdentity",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceLedgerArtifactRef": {
      "additionalProperties": false,
      "description": "Artifact reference for canonical evidence JSONL, including a zero-line ledger.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "const": "evidence_records",
          "default": "evidence_records",
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "EvidenceLedgerArtifactRef",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/evidence-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguity_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "ambiguity_count": {
      "minimum": 0,
      "title": "Ambiguity Count",
      "type": "integer"
    },
    "analyzer": {
      "$ref": "#/$defs/AnalyzerIdentity"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_artifact": {
      "$ref": "#/$defs/EvidenceLedgerArtifactRef"
    },
    "evidence_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Fingerprint",
      "type": "string"
    },
    "evidence_count": {
      "minimum": 0,
      "title": "Evidence Count",
      "type": "integer"
    },
    "implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Implementation Version",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "media_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Media Bundle Fingerprint",
      "type": "string"
    },
    "request_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "response_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "response_created_at": {
      "format": "date-time",
      "title": "Response Created At",
      "type": "string"
    },
    "response_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "transcript_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Bundle Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "evidence_bundle_fingerprint",
    "transcript_bundle_fingerprint",
    "media_bundle_fingerprint",
    "request_fingerprint",
    "response_fingerprint",
    "response_created_at",
    "implementation_version",
    "analyzer",
    "response_artifact",
    "evidence_artifact",
    "ambiguity_artifact",
    "evidence_count",
    "ambiguity_count",
    "started_at",
    "created_at"
  ],
  "title": "EvidenceManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
