{
  "$defs": {
    "AgentExecutionMode": {
      "enum": [
        "external_exchange",
        "test_fixture"
      ],
      "title": "AgentExecutionMode",
      "type": "string"
    },
    "AgentIdentity": {
      "additionalProperties": false,
      "properties": {
        "context_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Context Id",
          "type": "string"
        },
        "execution_mode": {
          "$ref": "#/$defs/AgentExecutionMode"
        },
        "executor": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Executor",
          "type": "string"
        },
        "external_api_used": {
          "title": "External Api Used",
          "type": "boolean"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentRole"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "provider",
        "model",
        "version",
        "executor",
        "context_id",
        "execution_mode",
        "external_api_used"
      ],
      "title": "AgentIdentity",
      "type": "object"
    },
    "AgentRole": {
      "enum": [
        "author",
        "auditor",
        "reviser"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AuditDisposition": {
      "enum": [
        "human_review_ready",
        "revision_required",
        "blocked"
      ],
      "title": "AuditDisposition",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/audit-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_run_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "audit_claims_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "auditor": {
      "$ref": "#/$defs/AgentIdentity"
    },
    "authoring_context_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Authoring Context Ids",
      "type": "array"
    },
    "bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Fingerprint",
      "type": "string"
    },
    "claim_comparison_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "claim_comparison_count": {
      "maximum": 200000,
      "minimum": 1,
      "title": "Claim Comparison Count",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/AuditDisposition"
    },
    "findings_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "fixed_evidence_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixed Evidence Fingerprint",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "p0_count": {
      "minimum": 0,
      "title": "P0 Count",
      "type": "integer"
    },
    "p1_count": {
      "minimum": 0,
      "title": "P1 Count",
      "type": "integer"
    },
    "p2_count": {
      "minimum": 0,
      "title": "P2 Count",
      "type": "integer"
    },
    "prior_auditor_context_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 2,
      "title": "Prior Auditor Context Ids",
      "type": "array"
    },
    "request_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "response_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "response_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_draft_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Draft Sha256",
      "type": "string"
    },
    "target_draft_version": {
      "pattern": "^v00[1-3]$",
      "title": "Target Draft Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "target_draft_version",
    "target_draft_sha256",
    "fixed_evidence_fingerprint",
    "request_fingerprint",
    "response_fingerprint",
    "bundle_fingerprint",
    "authoring_context_ids",
    "auditor",
    "audit_claims_artifact",
    "claim_comparison_artifact",
    "findings_artifact",
    "response_artifact",
    "agent_run_artifact",
    "p0_count",
    "p1_count",
    "p2_count",
    "claim_comparison_count",
    "disposition",
    "created_at"
  ],
  "title": "AuditManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
