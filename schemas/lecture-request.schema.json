{
  "$defs": {
    "AmbiguityRecord": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": {
          "pattern": "^A[0-9]{6}$",
          "title": "Ambiguity Id",
          "type": "string"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/UncertaintyAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "resolution": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus",
          "default": "needs_review"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 128,
          "title": "Source Refs",
          "type": "array"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "status": {
          "$ref": "#/$defs/AmbiguityStatus",
          "default": "unresolved"
        }
      },
      "required": [
        "ambiguity_id",
        "description"
      ],
      "title": "AmbiguityRecord",
      "type": "object"
    },
    "AmbiguityStatus": {
      "enum": [
        "unresolved",
        "resolved"
      ],
      "title": "AmbiguityStatus",
      "type": "string"
    },
    "AssignmentRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^R[0-9]{6}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "text": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "text"
      ],
      "title": "AssignmentRequirement",
      "type": "object"
    },
    "AuthoringProfile": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8}){0,3}$",
          "title": "Language",
          "type": "string"
        },
        "profile_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Profile Id",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ProfileRule"
          },
          "maxItems": 100,
          "title": "Rules",
          "type": "array"
        },
        "skills": {
          "items": {
            "$ref": "#/$defs/ProfileSkill"
          },
          "maxItems": 32,
          "title": "Skills",
          "type": "array"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "version",
        "language"
      ],
      "title": "AuthoringProfile",
      "type": "object"
    },
    "ClarificationInput": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": {
          "pattern": "^A[0-9]{6}$",
          "title": "Ambiguity Id",
          "type": "string"
        },
        "confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirmation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "decision": {
          "enum": [
            "resolved",
            "supplemented",
            "deferred"
          ],
          "title": "Decision",
          "type": "string"
        },
        "evidence_bundle_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Bundle Fingerprint",
          "type": "string"
        },
        "rationale": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 32,
          "title": "Source Refs",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "evidence_bundle_fingerprint",
        "ambiguity_id",
        "decision",
        "rationale"
      ],
      "title": "ClarificationInput",
      "type": "object"
    },
    "ClarificationRecord": {
      "additionalProperties": false,
      "properties": {
        "clarification": {
          "$ref": "#/$defs/ClarificationInput"
        },
        "job_id": {
          "maxLength": 63,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Job Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "recorded_by": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Recorded By",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "recorded_by",
        "recorded_at",
        "clarification"
      ],
      "title": "ClarificationRecord",
      "type": "object"
    },
    "Confirmation": {
      "additionalProperties": false,
      "properties": {
        "provided_by": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provided By",
          "type": "string"
        },
        "statement": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "provided_by",
        "statement"
      ],
      "title": "Confirmation",
      "type": "object"
    },
    "LectureAsset": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 12000000,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_refs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "source_refs"
      ],
      "title": "LectureAsset",
      "type": "object"
    },
    "LectureGuidance": {
      "additionalProperties": false,
      "properties": {
        "authoring": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Authoring",
          "type": "string"
        },
        "revision": {
          "const": "1",
          "default": "1",
          "title": "Revision",
          "type": "string"
        },
        "visual_audit": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Visual Audit",
          "type": "string"
        },
        "visual_planning": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Visual Planning",
          "type": "string"
        }
      },
      "required": [
        "authoring",
        "visual_planning",
        "visual_audit"
      ],
      "title": "LectureGuidance",
      "type": "object"
    },
    "LectureSource": {
      "additionalProperties": false,
      "properties": {
        "evidence_roles": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidence Roles",
          "type": "array"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "current_lecture",
            "previous_lecture",
            "clarification",
            "supplement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 128,
          "title": "Source Refs",
          "type": "array"
        },
        "title": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "locator"
      ],
      "title": "LectureSource",
      "type": "object"
    },
    "ProfileRule": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "content",
            "format",
            "calculation",
            "diagram",
            "content_audit",
            "visual_audit"
          ],
          "title": "Scope",
          "type": "string"
        },
        "text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "text"
      ],
      "title": "ProfileRule",
      "type": "object"
    },
    "ProfileSkill": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "ProfileSkill",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "unreviewed",
        "needs_review",
        "accepted",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "ref_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Id"
        },
        "region": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "title": "SourceLocator",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "description": "Transcript-record semantic fingerprint or canonical frame artifact SHA-256",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "kind": {
          "$ref": "#/$defs/SourceRefKind"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "required": [
        "kind",
        "ref_id",
        "content_sha256"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceRefKind": {
      "enum": [
        "transcript_segment",
        "frame",
        "approved_artifact",
        "pdf_text",
        "pdf_page",
        "image",
        "notes"
      ],
      "title": "SourceRefKind",
      "type": "string"
    },
    "UncertaintyAssessment": {
      "additionalProperties": false,
      "properties": {
        "impact": {
          "enum": [
            "minor",
            "material"
          ],
          "title": "Impact",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_unclear",
            "conflicting_sources",
            "general_knowledge",
            "organization_rule",
            "particular_event",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "impact",
        "question"
      ],
      "title": "UncertaintyAssessment",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v2/lecture-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/AmbiguityRecord"
      },
      "maxItems": 10000,
      "title": "Ambiguities",
      "type": "array"
    },
    "clarifications": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ClarificationRecord"
          },
          "maxItems": 1000,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarifications"
    },
    "crop_assets": {
      "items": {
        "$ref": "#/$defs/LectureAsset"
      },
      "maxItems": 10000,
      "title": "Crop Assets",
      "type": "array"
    },
    "evidence_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Fingerprint",
      "type": "string"
    },
    "external_api_allowed": {
      "title": "External Api Allowed",
      "type": "boolean"
    },
    "guidance": {
      "anyOf": [
        {
          "$ref": "#/$defs/LectureGuidance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "legacy_draft_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Legacy Draft Sha256"
    },
    "output_mode": {
      "enum": [
        "worked_explanation",
        "submission_answer"
      ],
      "title": "Output Mode",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/AuthoringProfile"
    },
    "profile_snapshot_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Snapshot Sha256",
      "type": "string"
    },
    "request_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/AssignmentRequirement"
      },
      "maxItems": 100,
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_state": {
      "enum": [
        "EVIDENCE_READY",
        "DRAFTED",
        "AUDITED",
        "REVISION_REQUIRED",
        "HUMAN_REVIEW_READY",
        "HUMAN_APPROVED",
        "EXPORTED",
        "APPROVED_ARCHIVE",
        "DOCUMENTS_VERIFIED"
      ],
      "title": "Source State",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/LectureSource"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "version": {
      "pattern": "^v(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "source_state",
    "request_fingerprint",
    "evidence_bundle_fingerprint",
    "profile_snapshot_sha256",
    "version",
    "output_mode",
    "profile",
    "sources",
    "external_api_allowed"
  ],
  "title": "LectureRequest",
  "type": "object",
  "x-schema-version": "2.0"
}
