{
  "$defs": {
    "InventoryFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 134217728,
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "InventoryFile",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v2/rich-deliverable-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_target_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Target Sha256",
      "type": "string"
    },
    "content_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "entrypoints": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Entrypoints",
      "type": "object"
    },
    "evidence_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Bundle Fingerprint",
      "type": "string"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/InventoryFile"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Inventory",
      "type": "array"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "profile_snapshot_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Snapshot Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "const": "HUMAN_REVIEW_READY",
      "default": "HUMAN_REVIEW_READY",
      "title": "State",
      "type": "string"
    },
    "version": {
      "pattern": "^v(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "version",
    "content_sha256",
    "evidence_bundle_fingerprint",
    "profile_snapshot_sha256",
    "approval_target_sha256",
    "inventory",
    "entrypoints"
  ],
  "title": "RichDeliverableManifest",
  "type": "object",
  "x-schema-version": "2.0"
}
