{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CharacterLengthCheck": {
      "additionalProperties": false,
      "description": "Machine-produced result suitable for manifests and external requests.",
      "properties": {
        "actual_chars": {
          "maximum": 4000000,
          "minimum": 0,
          "title": "Actual Chars",
          "type": "integer"
        },
        "below_minimum_by": {
          "default": 0,
          "maximum": 4000000,
          "minimum": 0,
          "title": "Below Minimum By",
          "type": "integer"
        },
        "counting_rule": {
          "const": "strip-surrounding-whitespace-then-python-code-points-v1",
          "default": "strip-surrounding-whitespace-then-python-code-points-v1",
          "title": "Counting Rule",
          "type": "string"
        },
        "effective": {
          "$ref": "#/$defs/EffectiveCharacterLengthConstraint"
        },
        "over_maximum_by": {
          "default": 0,
          "maximum": 4000000,
          "minimum": 0,
          "title": "Over Maximum By",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "actual_chars",
        "effective",
        "passed"
      ],
      "title": "CharacterLengthCheck",
      "type": "object"
    },
    "EffectiveCharacterLengthConstraint": {
      "additionalProperties": false,
      "description": "Resolved range used by every deterministic length gate.",
      "properties": {
        "max_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chars"
        },
        "maximum_adjustments": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maximum Adjustments",
          "type": "integer"
        },
        "min_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Chars"
        },
        "minimum_source": {
          "enum": [
            "unspecified",
            "explicit",
            "default_80_percent"
          ],
          "title": "Minimum Source",
          "type": "string"
        }
      },
      "required": [
        "minimum_source"
      ],
      "title": "EffectiveCharacterLengthConstraint",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/character-length-adjustment-attempt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic failed gate; the LLM receives facts, never a counting task.",
  "properties": {
    "candidate_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "check": {
      "$ref": "#/$defs/CharacterLengthCheck"
    },
    "correction_number": {
      "maximum": 10,
      "minimum": 0,
      "title": "Correction Number",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "instruction": {
      "const": "Revise only to fit the supplied character range; do not estimate or count characters.",
      "default": "Revise only to fit the supplied character range; do not estimate or count characters.",
      "title": "Instruction",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "response_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target_draft_version": {
      "pattern": "^v[0-9]{3}$",
      "title": "Target Draft Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "target_draft_version",
    "correction_number",
    "response_fingerprint",
    "candidate_artifact",
    "check",
    "created_at"
  ],
  "title": "CharacterLengthAdjustmentAttempt",
  "type": "object",
  "x-schema-version": "1.0"
}
