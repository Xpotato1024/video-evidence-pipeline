{
  "$defs": {
    "AcquisitionEvidence": {
      "additionalProperties": false,
      "properties": {
        "actual_acquired_size": {
          "minimum": 1,
          "title": "Actual Acquired Size",
          "type": "integer"
        },
        "adapter_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "backend": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "backend_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "credential_mode": {
          "$ref": "#/$defs/CredentialMode"
        },
        "declared_content_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Content Length"
        },
        "final_host": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.:-]+$",
          "title": "Final Host",
          "type": "string"
        },
        "http_status_category": {
          "$ref": "#/$defs/HttpStatusCategory"
        },
        "obtained_at": {
          "format": "date-time",
          "title": "Obtained At",
          "type": "string"
        },
        "redirect_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Redirect Count",
          "type": "integer"
        },
        "requested_host": {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.:-]+$",
          "title": "Requested Host",
          "type": "string"
        },
        "response_content_type": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Content Type"
        },
        "transport": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Transport",
          "type": "string"
        },
        "warnings": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "adapter_kind",
        "transport",
        "backend",
        "backend_version",
        "obtained_at",
        "requested_host",
        "final_host",
        "redirect_count",
        "http_status_category",
        "actual_acquired_size",
        "credential_mode"
      ],
      "title": "AcquisitionEvidence",
      "type": "object"
    },
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "configuration_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/ProducerIdentity"
        },
        "redacted_error": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Error"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "artifact",
        "producer",
        "configuration_sha256",
        "created_at"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CredentialMode": {
      "enum": [
        "none",
        "environment-token",
        "browser-cookie"
      ],
      "title": "CredentialMode",
      "type": "string"
    },
    "HttpStatusCategory": {
      "enum": [
        "2xx",
        "not-observed"
      ],
      "title": "HttpStatusCategory",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ProducerKind": {
      "enum": [
        "adapter",
        "tool"
      ],
      "title": "ProducerKind",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "local_file",
        "direct_http",
        "panopto",
        "box",
        "generic_ytdlp"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/source-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acquisition_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcquisitionEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact_record": {
      "$ref": "#/$defs/ArtifactRecord"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "display_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "locator_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Locator Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "source_kind",
    "display_name",
    "locator_fingerprint",
    "artifact_record",
    "created_at"
  ],
  "title": "SourceManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
