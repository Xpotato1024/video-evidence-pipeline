{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "DeviceSelectionReason": {
      "enum": [
        "explicit_cpu",
        "no_gpu_visible",
        "container_passthrough_unavailable",
        "backend_cuda_unavailable",
        "gpu_compute_type_unsupported",
        "insufficient_free_vram",
        "auto_gpu_selected",
        "explicit_cuda_selected",
        "gpu_resource_fallback"
      ],
      "title": "DeviceSelectionReason",
      "type": "string"
    },
    "GapPolicy": {
      "enum": [
        "record",
        "reject"
      ],
      "title": "GapPolicy",
      "type": "string"
    },
    "OverlapPolicy": {
      "enum": [
        "preserve",
        "reject"
      ],
      "title": "OverlapPolicy",
      "type": "string"
    },
    "SubtitleProvenance": {
      "enum": [
        "embedded",
        "official",
        "sidecar"
      ],
      "title": "SubtitleProvenance",
      "type": "string"
    },
    "TranscriptInterval": {
      "additionalProperties": false,
      "properties": {
        "end_ms": {
          "exclusiveMinimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "segment_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Segment Ids",
          "type": "array"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "title": "TranscriptInterval",
      "type": "object"
    },
    "TranscriptSource": {
      "enum": [
        "supplied",
        "normalized_subtitle",
        "asr"
      ],
      "title": "TranscriptSource",
      "type": "string"
    },
    "TranscriptionBackendIdentity": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model_repository": {
                "type": "string"
              },
              "source": {
                "const": "asr"
              }
            },
            "required": [
              "source",
              "model_repository"
            ]
          },
          "then": {
            "properties": {
              "compute_type": {
                "not": {
                  "type": "null"
                }
              },
              "configured_min_free_vram_mib": {
                "not": {
                  "type": "null"
                }
              },
              "container_image": {
                "not": {
                  "type": "null"
                }
              },
              "container_image_digest": {
                "not": {
                  "type": "null"
                }
              },
              "device_policy": {
                "not": {
                  "type": "null"
                }
              },
              "fallback": {
                "not": {
                  "type": "null"
                }
              },
              "model": {
                "not": {
                  "type": "null"
                }
              },
              "model_fingerprint": {
                "not": {
                  "type": "null"
                }
              },
              "model_repository": {
                "not": {
                  "type": "null"
                }
              },
              "model_revision": {
                "not": {
                  "type": "null"
                }
              },
              "model_storage_identity": {
                "not": {
                  "type": "null"
                }
              },
              "runtime": {
                "not": {
                  "type": "null"
                }
              },
              "runtime_version": {
                "not": {
                  "type": "null"
                }
              },
              "selected_device": {
                "not": {
                  "type": "null"
                }
              },
              "selection_reason": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "runtime",
              "runtime_version",
              "model",
              "model_repository",
              "model_revision",
              "model_fingerprint",
              "model_storage_identity",
              "device_policy",
              "selection_reason",
              "selected_device",
              "compute_type",
              "container_image",
              "container_image_digest",
              "fallback",
              "configured_min_free_vram_mib"
            ]
          }
        }
      ],
      "properties": {
        "candidate_free_vram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Free Vram Mib"
        },
        "candidate_gpu_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Gpu Index"
        },
        "candidate_gpu_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Gpu Name"
        },
        "candidate_total_vram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Total Vram Mib"
        },
        "compute_type": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute Type"
        },
        "configured_min_free_vram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Min Free Vram Mib"
        },
        "container_image": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Image"
        },
        "container_image_digest": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Image Digest"
        },
        "device_policy": {
          "anyOf": [
            {
              "pattern": "^(auto|cpu|cuda|cuda:[0-9]+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Policy"
        },
        "fallback": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback"
        },
        "fallback_from": {
          "anyOf": [
            {
              "const": "cuda",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback From"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "free_vram_at_selection_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Free Vram At Selection Mib"
        },
        "gpu_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Index"
        },
        "gpu_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpu Name"
        },
        "local_files_only": {
          "const": true,
          "default": true,
          "title": "Local Files Only",
          "type": "boolean"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "model_fingerprint": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Fingerprint"
        },
        "model_repository": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Repository"
        },
        "model_revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "model_storage_identity": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Storage Identity"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "runtime": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "runtime_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Version"
        },
        "selected_device": {
          "anyOf": [
            {
              "enum": [
                "cpu",
                "cuda"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Device"
        },
        "selection_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceSelectionReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/TranscriptSource"
        },
        "total_vram_mib": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Vram Mib"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name",
        "version"
      ],
      "title": "TranscriptionBackendIdentity",
      "type": "object"
    },
    "TranscriptionConfig": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "asr_profile": {
                "type": "string"
              }
            },
            "required": [
              "asr_profile"
            ]
          },
          "then": {
            "properties": {
              "asr_compute_type": {
                "const": "auto"
              }
            }
          }
        }
      ],
      "properties": {
        "asr_beam_size": {
          "const": 5,
          "default": 5,
          "title": "Asr Beam Size",
          "type": "integer"
        },
        "asr_compute_type": {
          "default": "auto",
          "enum": [
            "auto",
            "int8",
            "float16"
          ],
          "title": "Asr Compute Type",
          "type": "string"
        },
        "asr_condition_on_previous_text": {
          "const": false,
          "default": false,
          "title": "Asr Condition On Previous Text",
          "type": "boolean"
        },
        "asr_device": {
          "default": "auto",
          "pattern": "^(auto|cpu|cuda|cuda:[0-9]+)$",
          "title": "Asr Device",
          "type": "string"
        },
        "asr_language": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asr Language"
        },
        "asr_profile": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Repository-owned profile ID; absent only for legacy manifests/tests.",
          "title": "Asr Profile"
        },
        "asr_temperature": {
          "const": 0.0,
          "default": 0.0,
          "title": "Asr Temperature",
          "type": "number"
        },
        "gap_policy": {
          "$ref": "#/$defs/GapPolicy",
          "default": "record"
        },
        "maximum_segments": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maximum Segments",
          "type": "integer"
        },
        "maximum_total_text_chars": {
          "default": 64000000,
          "maximum": 256000000,
          "minimum": 1,
          "title": "Maximum Total Text Chars",
          "type": "integer"
        },
        "minimum_caption_coverage": {
          "default": 0.8,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Minimum Caption Coverage",
          "type": "number"
        },
        "overlap_policy": {
          "$ref": "#/$defs/OverlapPolicy",
          "default": "preserve"
        },
        "preferred_languages": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Preferred Languages",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "TranscriptionConfig",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/transcript-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "backends": {
            "contains": {
              "properties": {
                "source": {
                  "const": "asr"
                }
              },
              "required": [
                "source"
              ]
            }
          },
          "configuration": {
            "properties": {
              "asr_profile": {
                "type": "string"
              }
            },
            "required": [
              "asr_profile"
            ]
          }
        },
        "required": [
          "configuration",
          "backends"
        ]
      },
      "then": {
        "properties": {
          "backends": {
            "contains": {
              "allOf": [
                {
                  "if": {
                    "anyOf": [
                      {
                        "required": [
                          "runtime_version"
                        ]
                      },
                      {
                        "required": [
                          "model_repository"
                        ]
                      },
                      {
                        "required": [
                          "selection_reason"
                        ]
                      },
                      {
                        "required": [
                          "candidate_gpu_index"
                        ]
                      },
                      {
                        "required": [
                          "candidate_gpu_name"
                        ]
                      },
                      {
                        "required": [
                          "candidate_total_vram_mib"
                        ]
                      },
                      {
                        "required": [
                          "candidate_free_vram_mib"
                        ]
                      }
                    ]
                  },
                  "then": {
                    "properties": {
                      "model_repository": {
                        "not": {
                          "type": "null"
                        }
                      },
                      "runtime_version": {
                        "not": {
                          "type": "null"
                        }
                      },
                      "selection_reason": {
                        "not": {
                          "type": "null"
                        }
                      }
                    },
                    "required": [
                      "runtime_version",
                      "model_repository",
                      "selection_reason"
                    ]
                  }
                }
              ],
              "properties": {
                "compute_type": {
                  "not": {
                    "type": "null"
                  }
                },
                "configured_min_free_vram_mib": {
                  "not": {
                    "type": "null"
                  }
                },
                "container_image": {
                  "not": {
                    "type": "null"
                  }
                },
                "container_image_digest": {
                  "not": {
                    "type": "null"
                  }
                },
                "device_policy": {
                  "not": {
                    "type": "null"
                  }
                },
                "fallback": {
                  "not": {
                    "type": "null"
                  }
                },
                "model": {
                  "not": {
                    "type": "null"
                  }
                },
                "model_fingerprint": {
                  "not": {
                    "type": "null"
                  }
                },
                "model_revision": {
                  "not": {
                    "type": "null"
                  }
                },
                "model_storage_identity": {
                  "not": {
                    "type": "null"
                  }
                },
                "runtime": {
                  "not": {
                    "type": "null"
                  }
                },
                "selected_device": {
                  "not": {
                    "type": "null"
                  }
                },
                "source": {
                  "const": "asr"
                }
              },
              "required": [
                "source",
                "name",
                "version",
                "runtime",
                "model",
                "model_revision",
                "model_fingerprint",
                "model_storage_identity",
                "device_policy",
                "selected_device",
                "gpu_index",
                "gpu_name",
                "total_vram_mib",
                "free_vram_at_selection_mib",
                "configured_min_free_vram_mib",
                "compute_type",
                "container_image",
                "container_image_digest",
                "fallback",
                "fallback_from",
                "fallback_reason",
                "local_files_only"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "backends": {
      "items": {
        "$ref": "#/$defs/TranscriptionBackendIdentity"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Backends",
      "type": "array"
    },
    "caption_coverage": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caption Coverage"
    },
    "configuration": {
      "$ref": "#/$defs/TranscriptionConfig"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_ms": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/TranscriptInterval"
      },
      "title": "Gaps",
      "type": "array"
    },
    "implementation_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Implementation Version",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "media_bundle_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Media Bundle Fingerprint",
      "type": "string"
    },
    "overlaps": {
      "items": {
        "$ref": "#/$defs/TranscriptInterval"
      },
      "title": "Overlaps",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_count": {
      "minimum": 1,
      "title": "Segment Count",
      "type": "integer"
    },
    "segments_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "selected_source_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Selected Source Artifacts",
      "type": "array"
    },
    "selected_subtitle_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubtitleProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_subtitle_stream_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Subtitle Stream Index"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "transcription_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcription Fingerprint",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "transcription_fingerprint",
    "media_bundle_fingerprint",
    "implementation_version",
    "configuration",
    "backends",
