{
  "$defs": {
    "EffectiveCharacterLengthConstraint": {
      "additionalProperties": false,
      "description": "Resolved range used by every deterministic length gate.",
      "properties": {
        "max_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chars"
        },
        "maximum_adjustments": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maximum Adjustments",
          "type": "integer"
        },
        "min_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Chars"
        },
        "minimum_source": {
          "enum": [
            "unspecified",
            "explicit",
            "default_80_percent"
          ],
          "title": "Minimum Source",
          "type": "string"
        }
      },
      "required": [
        "minimum_source"
      ],
      "title": "EffectiveCharacterLengthConstraint",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/character-length-check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-produced result suitable for manifests and external requests.",
  "properties": {
    "actual_chars": {
      "maximum": 4000000,
      "minimum": 0,
      "title": "Actual Chars",
      "type": "integer"
    },
    "below_minimum_by": {
      "default": 0,
      "maximum": 4000000,
      "minimum": 0,
      "title": "Below Minimum By",
      "type": "integer"
    },
    "counting_rule": {
      "const": "strip-surrounding-whitespace-then-python-code-points-v1",
      "default": "strip-surrounding-whitespace-then-python-code-points-v1",
      "title": "Counting Rule",
      "type": "string"
    },
    "effective": {
      "$ref": "#/$defs/EffectiveCharacterLengthConstraint"
    },
    "over_maximum_by": {
      "default": 0,
      "maximum": 4000000,
      "minimum": 0,
      "title": "Over Maximum By",
      "type": "integer"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    }
  },
  "required": [
    "actual_chars",
    "effective",
    "passed"
  ],
  "title": "CharacterLengthCheck",
  "type": "object",
  "x-schema-version": "1.0"
}
