{
  "$defs": {
    "TranscriptSource": {
      "enum": [
        "supplied",
        "normalized_subtitle",
        "asr"
      ],
      "title": "TranscriptSource",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/transcription-backend-identity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "local_files_only": {
      "const": true,
      "default": true,
      "title": "Local Files Only",
      "type": "boolean"
    },
    "model": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "model_fingerprint": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Fingerprint"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "runtime": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime"
    },
    "source": {
      "$ref": "#/$defs/TranscriptSource"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "source",
    "name",
    "version"
  ],
  "title": "TranscriptionBackendIdentity",
  "type": "object",
  "x-schema-version": "1.0"
}
