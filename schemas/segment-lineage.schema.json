{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SubtitleProvenance": {
      "enum": [
        "embedded",
        "official",
        "sidecar"
      ],
      "title": "SubtitleProvenance",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/segment-lineage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend_identity_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Backend Identity Fingerprint",
      "type": "string"
    },
    "source_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_record_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "source_stream_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Stream Index"
    },
    "subtitle_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubtitleProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source_artifact",
    "source_record_id",
    "backend_identity_fingerprint"
  ],
  "title": "SegmentLineage",
  "type": "object",
  "x-schema-version": "1.0"
}
