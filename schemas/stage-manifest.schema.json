{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceLedgerArtifactRef": {
      "additionalProperties": false,
      "description": "Artifact reference for canonical evidence JSONL, including a zero-line ledger.",
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "const": "evidence_records",
          "default": "evidence_records",
          "title": "Artifact Type",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "relative_storage_path": {
          "title": "Relative Storage Path",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "content_sha256",
        "size_bytes",
        "relative_storage_path"
      ],
      "title": "EvidenceLedgerArtifactRef",
      "type": "object"
    },
    "JobState": {
      "enum": [
        "CREATED",
        "AUTHORIZED",
        "ACQUIRED",
        "NORMALIZED",
        "TRANSCRIBED",
        "EVIDENCE_READY",
        "DRAFTED",
        "AUDITED",
        "REVISION_REQUIRED",
        "HUMAN_REVIEW_READY",
        "HUMAN_APPROVED",
        "EXPORTED",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "JobState",
      "type": "string"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProducerKind"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "version"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "ProducerKind": {
      "enum": [
        "adapter",
        "tool"
      ],
      "title": "ProducerKind",
      "type": "string"
    },
    "StageStatus": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/stage-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "input_artifacts": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EvidenceLedgerArtifactRef"
          },
          {
            "$ref": "#/$defs/ArtifactRef"
          }
        ]
      },
      "title": "Input Artifacts",
      "type": "array"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "output_artifacts": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/EvidenceLedgerArtifactRef"
          },
          {
            "$ref": "#/$defs/ArtifactRef"
          }
        ]
      },
      "title": "Output Artifacts",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "redacted_error": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Redacted Error"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state_transition": {
      "$ref": "#/$defs/JobState"
    },
    "status": {
      "$ref": "#/$defs/StageStatus"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "stage",
    "status",
    "state_transition",
    "producer",
    "configuration_sha256",
    "started_at",
    "finished_at"
  ],
  "title": "StageManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
