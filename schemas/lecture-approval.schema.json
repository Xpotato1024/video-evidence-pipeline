{
  "$defs": {
    "ReviewerIdentity": {
      "additionalProperties": false,
      "description": "A local CLI assertion, not an authenticated or signed identity.",
      "properties": {
        "assertion_method": {
          "const": "cli_asserted",
          "default": "cli_asserted",
          "title": "Assertion Method",
          "type": "string"
        },
        "cryptographically_verified": {
          "const": false,
          "default": false,
          "title": "Cryptographically Verified",
          "type": "boolean"
        },
        "identity": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        }
      },
      "required": [
        "identity"
      ],
      "title": "ReviewerIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v2/lecture-approval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_target_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Target Sha256",
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "title": "Approved At",
      "type": "string"
    },
    "basis": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "confirmed_by_user": {
      "const": true,
      "default": true,
      "title": "Confirmed By User",
      "type": "boolean"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "record_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "reviewer": {
      "$ref": "#/$defs/ReviewerIdentity"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "const": "HUMAN_APPROVED",
      "default": "HUMAN_APPROVED",
      "title": "State",
      "type": "string"
    },
    "version": {
      "pattern": "^v(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "version",
    "approval_target_sha256",
    "reviewer",
    "basis",
    "approved_at",
    "record_sha256"
  ],
  "title": "LectureApproval",
  "type": "object",
  "x-schema-version": "2.0"
}
