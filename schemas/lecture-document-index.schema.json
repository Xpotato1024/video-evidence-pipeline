{
  "$defs": {
    "LectureDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 65536,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "title": "LectureDocument",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v2/lecture-document-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/LectureDocument"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "sources"
  ],
  "title": "LectureDocumentIndex",
  "type": "object",
  "x-schema-version": "2.0"
}
