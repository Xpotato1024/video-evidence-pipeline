{
  "$defs": {
    "RefinementAmbiguity": {
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": {
          "pattern": "^RA[0-9]{6}$",
          "title": "Ambiguity Id",
          "type": "string"
        },
        "description": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^T[0-9]{6}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "ambiguity_id",
        "segment_id",
        "description",
        "source_refs"
      ],
      "title": "RefinementAmbiguity",
      "type": "object"
    },
    "RefinementEdit": {
      "additionalProperties": false,
      "properties": {
        "edit_id": {
          "pattern": "^R[0-9]{6}$",
          "title": "Edit Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RefinementEditKind"
        },
        "original_segment_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Segment Fingerprint",
          "type": "string"
        },
        "refined_text": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Refined Text",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^T[0-9]{6}$",
          "title": "Segment Id",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "edit_id",
        "segment_id",
        "original_segment_fingerprint",
        "refined_text",
        "kind",
        "source_refs"
      ],
      "title": "RefinementEdit",
      "type": "object"
    },
    "RefinementEditKind": {
      "enum": [
        "automatic",
        "semantic"
      ],
      "title": "RefinementEditKind",
      "type": "string"
    },
    "RefinementExecutionMode": {
      "enum": [
        "external_exchange",
        "test_fixture"
      ],
      "title": "RefinementExecutionMode",
      "type": "string"
    },
    "RefinerIdentity": {
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "$ref": "#/$defs/RefinementExecutionMode"
        },
        "executor": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Executor",
          "type": "string"
        },
        "external_api_used": {
          "title": "External Api Used",
          "type": "boolean"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "version",
        "executor",
        "execution_mode",
        "external_api_used"
      ],
      "title": "RefinerIdentity",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "description": "Transcript-record semantic fingerprint or canonical frame artifact SHA-256",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "end_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "kind": {
          "$ref": "#/$defs/SourceRefKind"
        },
        "ref_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ref Id",
          "type": "string"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        }
      },
      "required": [
        "kind",
        "ref_id",
        "content_sha256"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceRefKind": {
      "enum": [
        "transcript_segment",
        "frame",
        "approved_artifact",
        "pdf_text",
        "pdf_page",
        "image",
        "notes"
      ],
      "title": "SourceRefKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/refinement-response-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/RefinementAmbiguity"
      },
      "maxItems": 100000,
      "title": "Ambiguities",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "refiner": {
      "$ref": "#/$defs/RefinerIdentity"
    },
    "request_fingerprint": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_edits": {
      "items": {
        "$ref": "#/$defs/RefinementEdit"
      },
      "maxItems": 100000,
      "title": "Semantic Edits",
      "type": "array"
    }
  },
  "required": [
    "request_fingerprint",
    "refiner",
    "created_at"
  ],
  "title": "RefinementResponseManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
