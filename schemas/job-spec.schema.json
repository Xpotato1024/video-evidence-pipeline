{
  "$defs": {
    "AssignmentSpec": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "maxLength": 32,
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "length": {
          "anyOf": [
            {
              "$ref": "#/$defs/CharacterLengthConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requirements": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "pattern": ".*\\S.*",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Requirements",
          "type": "array"
        },
        "task_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Type",
          "type": "string"
        }
      },
      "required": [
        "task_type",
        "language"
      ],
      "title": "AssignmentSpec",
      "type": "object"
    },
    "CharacterLengthConstraint": {
      "additionalProperties": false,
      "description": "Raw assignment values; ``None`` means the author did not specify the bound.",
      "properties": {
        "max_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chars"
        },
        "maximum_adjustments": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maximum Adjustments",
          "type": "integer"
        },
        "min_chars": {
          "anyOf": [
            {
              "maximum": 4000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Chars"
        }
      },
      "title": "CharacterLengthConstraint",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "title": "OutputSpec",
      "type": "object"
    },
    "PrimaryInputKind": {
      "description": "The one primary item that becomes a transcript.\n\n``source`` remains the v1 acquisition projection.  Keeping it in place\nlets historic video job YAML and its fingerprint remain valid while newer\njobs opt into an explicit primary kind.",
      "enum": [
        "video",
        "audio",
        "transcript"
      ],
      "title": "PrimaryInputKind",
      "type": "string"
    },
    "PrimaryInputSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/PrimaryInputKind"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PrimaryInputSpec",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "local_file",
        "direct_http",
        "panopto",
        "box",
        "generic_ytdlp"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "SourceSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "locator": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "locator"
      ],
      "title": "SourceSpec",
      "type": "object"
    },
    "SupportingInputKind": {
      "enum": [
        "pdf",
        "image",
        "notes"
      ],
      "title": "SupportingInputKind",
      "type": "string"
    },
    "SupportingInputSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/SupportingInputKind"
        },
        "locator": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "locator"
      ],
      "title": "SupportingInputSpec",
      "type": "object"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/job-spec.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment": {
      "$ref": "#/$defs/AssignmentSpec"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "job_id": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Job Id",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/OutputSpec"
    },
    "primary_input": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimaryInputSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceSpec"
    },
    "supporting_inputs": {
      "items": {
        "$ref": "#/$defs/SupportingInputSpec"
      },
      "maxItems": 32,
      "title": "Supporting Inputs",
      "type": "array"
    }
  },
  "required": [
    "job_id",
    "created_at",
    "source",
    "assignment",
    "output"
  ],
  "title": "JobSpec",
  "type": "object",
  "x-schema-version": "1.0"
}
