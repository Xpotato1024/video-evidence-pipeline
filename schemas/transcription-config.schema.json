{
  "$defs": {
    "GapPolicy": {
      "enum": [
        "record",
        "reject"
      ],
      "title": "GapPolicy",
      "type": "string"
    },
    "OverlapPolicy": {
      "enum": [
        "preserve",
        "reject"
      ],
      "title": "OverlapPolicy",
      "type": "string"
    }
  },
  "$id": "https://schemas.video-evidence-pipeline.local/v1/transcription-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asr_beam_size": {
      "const": 5,
      "default": 5,
      "title": "Asr Beam Size",
      "type": "integer"
    },
    "asr_compute_type": {
      "default": "auto",
      "enum": [
        "auto",
        "int8",
        "float16"
      ],
      "title": "Asr Compute Type",
      "type": "string"
    },
    "asr_condition_on_previous_text": {
      "const": false,
      "default": false,
      "title": "Asr Condition On Previous Text",
      "type": "boolean"
    },
    "asr_device": {
      "default": "auto",
      "enum": [
        "auto",
        "cpu",
        "cuda"
      ],
      "title": "Asr Device",
      "type": "string"
    },
    "asr_language": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asr Language"
    },
    "asr_temperature": {
      "const": 0.0,
      "default": 0.0,
      "title": "Asr Temperature",
      "type": "number"
    },
    "gap_policy": {
      "$ref": "#/$defs/GapPolicy",
      "default": "record"
    },
    "maximum_segments": {
      "default": 100000,
      "maximum": 1000000,
      "minimum": 1,
      "title": "Maximum Segments",
      "type": "integer"
    },
    "maximum_total_text_chars": {
      "default": 64000000,
      "maximum": 256000000,
      "minimum": 1,
      "title": "Maximum Total Text Chars",
      "type": "integer"
    },
    "minimum_caption_coverage": {
      "default": 0.8,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Minimum Caption Coverage",
      "type": "number"
    },
    "overlap_policy": {
      "$ref": "#/$defs/OverlapPolicy",
      "default": "preserve"
    },
    "preferred_languages": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Preferred Languages",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "TranscriptionConfig",
  "type": "object",
  "x-schema-version": "1.0"
}
